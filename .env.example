# Optional. Defaults to data/siata_intelligence.db
# DATABASE_URL=sqlite:///./data/siata_intelligence.db

# Periodic SIATA sync; minimum interval is 60 seconds.
SIATA_SYNC_ENABLED=true
SIATA_SYNC_INTERVAL_SECONDS=300
SIATA_DISCOVERY_ENABLED=true
SIATA_DISCOVERY_INTERVAL_SECONDS=86400

# Separate external products; all are stored with provider provenance and kept
# apart from SIATA station observations.
OPEN_METEO_SYNC_ENABLED=true
OPEN_METEO_SYNC_INTERVAL_SECONDS=10800
NASA_POWER_SYNC_ENABLED=true
NASA_POWER_SYNC_INTERVAL_SECONDS=86400
IDEAM_RADAR_CATALOG_ENABLED=true
IDEAM_RADAR_CATALOG_INTERVAL_SECONDS=21600
SIATA_AUTO_ML_ENABLED=true
SIATA_AUTO_ML_INTERVAL_SECONDS=21600

# Only needed when the frontend is served from a different origin.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Next.js uses this server-side rewrite to reach the FastAPI service.
SIATA_BACKEND_URL=http://127.0.0.1:8000

# Optional hosted NVIDIA NIM API. Inference runs remotely; no local model or GPU is used.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b

# Optional hosted fallback if NVIDIA_API_KEY is not configured.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731

# Jev currently uses its auditable deterministic policy engine. No Typesafe
# service URL/SDK contract is configured, so no external Typesafe calls occur.
