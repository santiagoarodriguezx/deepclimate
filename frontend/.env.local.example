# Same-origin Next.js API proxy target (never expose service credentials here).
SIATA_BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_BACKEND_DOCS=http://127.0.0.1:8000
# Optional OSM vector map style override. Default: OpenFreeMap Positron (no key / published request quota).
NEXT_PUBLIC_OPENFREEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
